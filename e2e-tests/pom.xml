<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gk3.demo</groupId>
        <artifactId>payment-compliance-saga-orchestrator</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>e2e-tests</artifactId>
    <packaging>jar</packaging>
    <name>e2e-tests</name>
    <description>
        Black-box end-to-end saga tests: builds the 3 service Docker images and the whole local
        stack (docker-compose.e2e.yml) through Testcontainers, then drives the saga purely through
        payment-service's and orchestrator-service's public REST APIs - no mocks, no direct DB or
        internal-class access. Opt-in only, see root pom's "e2e" profile.
    </description>

    <properties>
        <!-- No production code here, nothing to analyze or cover. -->
        <sonar.skip>true</sonar.skip>
        <jacoco.skip>true</jacoco.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.3.0</version>
            <scope>test</scope>
        </dependency>
        <!-- Without an SLF4J binding, Testcontainers silently swallows the `docker compose up`
             process output on failure (just "exited abnormally with code 1", no details). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
            <scope>test</scope>
        </dependency>
        <!-- Not used directly here (no mocks in black-box e2e tests) - but spring-boot-starter-
             parent unconditionally injects "-javaagent:${org.mockito:mockito-core:jar}" into every
             module's surefire argLine (for Mockito's inline mock maker). Without this dependency,
             that property never resolves, and the literal unresolved placeholder gets passed as
             the -javaagent path, crashing the forked test JVM before it can even start. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Compose build + container startup genuinely takes a few minutes. -->
                    <forkedProcessTimeoutInSeconds>600</forkedProcessTimeoutInSeconds>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
